{
  "name": "mor-reader",
  "version": "0.1.0",
  "description": "The MOR web reader: opens by link, fetches acts from relays, verifies them in the browser, renders documents and posts, and offers a way to reach the identity it is the door of.",
  "license": "MIT OR Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm": "sh ../genesis/scripts/build-wasm.sh",
    "build": "node --import tsx scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0"
  },
  "devDependencies": {
    "@noble/post-quantum": "0.7.1",
    "@types/node": "^22.20.4",
    "esbuild": "^0.25",
    "playwright-core": "1.56",
    "tsx": "^4",
    "typescript": "^5"
  }
}
