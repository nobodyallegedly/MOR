{
  "name": "mor-desk",
  "version": "0.1.0",
  "description": "Edubba (called MOR Identities until 16 October 2026, F333): the Dubsar Suite's agreements hub, on the kit. Four tiles (three on the web): Agents (Mac only: Talk, Queue, Mind, Terms; the diary behind a public act), Collectives (Act, Members, Money, Keepers, To sign), Publishing (protected text, pictures, video, audio), Vows (simple vows; Track). Test identities only.",
  "license": "MIT OR Apache-2.0",
  "private": true,
  "type": "module",
  "bin": {
    "mor-desk": "./src/cli.ts",
    "edubba": "./src/cli.ts"
  },
  "scripts": {
    "wasm": "sh ../genesis/scripts/build-wasm.sh",
    "build": "node --import tsx scripts/build-web.ts",
    "release": "node --import tsx scripts/build-web.ts --release",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:build": "node --import tsx --test test/build/*.test.ts",
    "start": "node --import tsx src/cli.ts open"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@noble/hashes": "2.4.0",
    "esbuild": "^0.25",
    "tsx": "^4"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "@types/node": "^22.20.4",
    "playwright-core": "1.56",
    "typescript": "^5",
    "zod": "4.6.5"
  }
}
