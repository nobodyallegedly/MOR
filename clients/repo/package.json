{
  "name": "mor-repo",
  "version": "0.1.0",
  "description": "The MOR repo client: a test collective under a founding agreement, releases of the code published as signed manifests, and a fresh machine fetching and verifying every file.",
  "license": "MIT OR Apache-2.0",
  "private": true,
  "type": "module",
  "bin": {
    "mor-repo": "./src/cli.ts"
  },
  "scripts": {
    "wasm": "sh ../genesis/scripts/build-wasm.sh",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "cli": "node --import tsx src/cli.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4",
    "typescript": "^5"
  }
}
