{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "typeRoots": [
      "../../clients/site/node_modules/@types"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "*.ts"
  ]
}
